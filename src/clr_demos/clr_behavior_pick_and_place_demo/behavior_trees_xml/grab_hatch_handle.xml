<root BTCPP_format="4"
    main_tree_to_execute="GrabHatchHandleR">

    <BehaviorTree ID="GrabHatchHandleR">
        <Sequence>
           
            <SubTree ID="TraverseRight"/>

            <SubTree ID="ApproachHatchHandleR"/>

            <SubTree ID="DetectHatchHandle" target_part="lorge/external_2_grab_handle" />

        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="GrabHatchHandleC">
        <Sequence>
           
            <SubTree ID="TraverseRight"/>

            <SubTree ID="ApproachHatchHandleC"/>

            <SubTree ID="DetectHatchHandle" target_part="lorge/external_1_grab_handle"/>

        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="TraverseRight">
        <Sequence>  
            <PlanToJointState
                name="traversing right"
                service_name="/plan_kinematic_path"
                group_name= "clr"
                joint_names="vention_rail_base_to_carriage;ewellix_lift_lower_to_higher;shoulder_pan_joint;shoulder_lift_joint;elbow_joint;wrist_1_joint;wrist_2_joint;wrist_3_joint"
                joint_positions="1.2;0.473;3.14159;-2.05949;-2.49582;0.20944;-0.0349066;-1.93732"
                tolerance="0.0001"
                trajectory="{gripper_traj}"/>

            <ExecuteTrajectory
                name="traversing"
                trajectory="{gripper_traj}"
                action_name="/execute_trajectory"/>

        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="ApproachHatchHandleL">
        <Sequence>  
            <CreateRandomTransform
                name="Create approach hatch handle (left) transform"
                transform_name="approach_hatch_handle_left_transform"
                center="1.7993;0.33935;1.3665"
                box_side="0.0;0.0;0.0"
                transform="{transform}"/>

            <ApplyTransform name="Rotate the transform"
                input_transform="{transform}"
                applied_transform_translation="0.0;0.0;0.0"
                applied_transform_rotation="0.0;0.707;-0.0;0.707"
                resulting_transform="{transform}"
                />

            <PublishTransform
                name="publish transform"
                input_transform="{transform}"
                />

            <SubTree ID="rrt_to_transform"
                transform="{transform}"
                group_name="clr"
                end_effector_name="grasp_frame"
                velocity_scaling="1.0"
                acceleration_scaling="1.0"
                />
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="ApproachHatchHandleR">
        <Sequence>  
            <CreateRandomTransform
                name="Create approach hatch handle (right) transform"
                transform_name="approach_hatch_handle_right_transform"
                center="1.9118;-0.558545;1.3595"
                box_side="0.0;0.0;0.0"
                transform="{transform}"/>

            <ApplyTransform name="Rotate the transform"
                input_transform="{transform}"
                applied_transform_translation="0.0;0.0;0.0"
                applied_transform_rotation="0.0;0.707;-0.0;0.707"
                resulting_transform="{transform}"
                />

            <PublishTransform
                name="publish transform"
                input_transform="{transform}"
                />

            <SubTree ID="rrt_to_transform"
                transform="{transform}"
                group_name="clr"
                end_effector_name="grasp_frame"
                velocity_scaling="1.0"
                acceleration_scaling="1.0"
                />
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="ApproachHatchHandleC">
        <Sequence>  
            <CreateRandomTransform
                name="Create approach hatch handle (center) transform"
                transform_name="approach_hatch_handle_center_transform"
                center="1.4991;-0.558316;1.3595"
                box_side="0.0;0.0;0.0"
                transform="{transform}"/>

            <ApplyTransform name="Rotate the transform"
                input_transform="{transform}"
                applied_transform_translation="0.0;0.0;0.0"
                applied_transform_rotation="0.0;0.707;-0.0;0.707"
                resulting_transform="{transform}"
                />

            <PublishTransform
                name="publish transform"
                input_transform="{transform}"
                />

            <SubTree ID="rrt_to_transform"
                transform="{transform}"
                group_name="clr"
                end_effector_name="grasp_frame"
                velocity_scaling="1.0"
                acceleration_scaling="1.0"
                />
        </Sequence>
    </BehaviorTree>


    <BehaviorTree ID="DetectHatchHandle">
        <Sequence>
            <SubTree ID="OpenGripper"/>

            <!--Gets color blob frame-->
            <SubTree ID="GetColorBlobPose" blob_pose="{blob_pose}" />

            <PoseToTransform name="Blob pose to transform"
                pose_stamped="{blob_pose}"
                transform_stamped="{transform}"
                />

            <PublishTransform
                name="publish transform"
                new_transform_name="found_blob_pose"
                input_transform="{transform}"
                />
                
            <!-- Look up the frame that the color blob actually publishes -->
            <AsyncTfLookup name="Look up color blob"
                base_frame="world"
                target_frame="found_blob_pose"
                tf="{transform}"
                />

            <!--offsets found blob pose-->
            <ApplyTransform name="Rotate the transform"
                input_transform="{transform}"
                applied_transform_translation="0.0;0.0;-0.1"
                applied_transform_rotation="0.2181662;0.0;0.0;0.0"
                resulting_transform="{transform}"
            />

            <PublishTransform
                name="publish transform"
                input_transform="{transform}"
                />
                
            <SubTree ID="DescendHatchHandle" target_part="{target_part}" _autoremap="true"/>
            <!-- <SubTree ID="DescendHatchHandle" target_part="lorge/external_2_grab_handle" _autoremap="true"/> -->

        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="DescendHatchHandle">
        <Sequence>  
            <AsyncTfLookup name="Look up found blob pose"
                    base_frame="world"
                    target_frame="found_blob_pose"
                    tf="{transform}"
                    />

            <ApplyTransform name="Rotate the transform"
                input_transform="{transform}"
                applied_transform_translation="0.0;0.0;0.15"
                applied_transform_rotation="0.0;-0.0;0.0;0.0"
                resulting_transform="{transform}"
                />

            <PublishTransform
                name="publish transform"
                new_transform_name="descend_hatch_handle"
                input_transform="{transform}"
                />
            <!-- "true" means disabling collisions (i.e., allowing touch) -->
            <SubTree ID="ToggleCollisionSubTree" 
                     allow_collision="true" 
                     target_part="{target_part}" 
                    _autoremap="true" />

            <SubTree ID="rrt_to_transform"
                transform="{transform}"
                group_name="clr"
                end_effector_name="grasp_frame"
                velocity_scaling="1.0"
                acceleration_scaling="1.0"
                />

            <SubTree ID="CloseGripper"/>

            <!-- "false" means re-enabling collisions (i.e., disallowing touch)
            <SubTree ID="ToggleCollisionSubTree" 
                     allow_collision="false" 
                     target_part="{target_part}"
                     /> -->
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="ToggleCollisionSubTree">
        <!-- Runs the underlying C++ Action Node -->
        <ToggleCollision allow_collision="{allow_collision}" target_part="{target_part}"/>
    </BehaviorTree>

    <BehaviorTree ID="OpenGripper">
        <Sequence>
            <PlanToJointState
                name="Plan to open the gripper"
                service_name="/plan_kinematic_path"
                group_name="hand"
                joint_names="finger_1_joint"
                joint_positions="0.023"
                tolerance="0.0001"
                trajectory="{gripper_traj}"/>

            <ExecuteTrajectory
                name="Open the gripper "
                trajectory="{gripper_traj}"
                action_name="/execute_trajectory"/>
        </Sequence>
    </BehaviorTree>
    

    <BehaviorTree ID="CloseGripper">
        <Sequence>
            <PlanToJointState
                name="Plan to close the gripper"
                service_name="/plan_kinematic_path"
                group_name="hand"
                joint_names="finger_1_joint"
                joint_positions="0.000"
                tolerance="0.0001"
                trajectory="{gripper_traj}"/>

            <ExecuteTrajectory
                name="Close the gripper"
                trajectory="{gripper_traj}"
                action_name="/execute_trajectory"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="GetColorBlobPose">
        <Sequence>
            <GetSyncedImagePointCloudDepth
                name="Get Synced Image Point Cloud Depth"
                point_cloud_topic_name="/wrist_mounted_camera/depth/color/points"
                depth_image_topic_name="/wrist_mounted_camera/aligned_depth_to_color/image_raw"
                rgb_camera_info="{rgb_camera_info}"
                rgb_camera_info_topic_name="/wrist_mounted_camera/color/camera_info"
                rgb_image_topic_name="/wrist_mounted_camera/color/image_raw"
            />

             <DetectColorBlobs
                name="DetectColorBlobs"
                blob_color="red"
                blob_pose="{blob_pose}"
                camera_info="{rgb_camera_info}"
                depth_image="{depth_image}"
                mask_image="{masked_blob_image}"
                min_blob_size="5.0"
                rgb_image="{rgb_image}"
            />

        </Sequence>
    </BehaviorTree>

</root>
